{
  "name": "sillytavern-voice-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SillyTavern 流式语音扩展：逐句朗读、AEC3 免提打断、角色音色映射与情感标签 DSL。",
  "license": "MIT",
  "author": "qishuilalala",
  "packageManager": "pnpm@12.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/sillytavern-voice-mode.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test",
    "check:release": "node scripts/check-release-gate.mjs",
    "check:all": "pnpm run typecheck && pnpm run lint && pnpm run check:i18n && pnpm run test && pnpm run build && pnpm run check:release",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@voice-mode/browser": "file:./vendor/voice-mode-browser-0.1.0.tgz",
    "@voice-mode/core": "file:./vendor/voice-mode-core-0.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.1"
  }
}
